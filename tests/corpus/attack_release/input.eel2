// attack_release.eel2
// Single-pole envelope follower using attack/release coefficients

@init
attack_ms  = 10;
release_ms = 100;
env = 0;

@slider
attack_coeff  = exp(-1 / (srate * attack_ms  * 0.001));
release_coeff = exp(-1 / (srate * release_ms * 0.001));

@sample
input_abs = spl0 < 0 ? -spl0 : spl0;
env = input_abs > env
    ? attack_coeff  * env + (1 - attack_coeff)  * input_abs
    : release_coeff * env + (1 - release_coeff) * input_abs;

spl0 = env;
spl1 = env;
